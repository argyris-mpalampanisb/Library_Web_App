@model Library_Web_App.Models.RentalViewModel
@{
    ViewData["Title"] = "My Rentals";
}

<h3>📋 My Rentals</h3>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.Rentals.Count == 0)
{
    <p class="text-muted">No rentals yet. <a asp-action="Index">Browse the library</a> to rent a book.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Book</th>
                <th>Author</th>
                <th>Rented On</th>
                <th>Due Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rentals)
            {
                var daysLeft = (r.DueDate - DateTime.UtcNow).TotalDays;
                var isOverdue = r.ReturnDate == null && daysLeft < 0;
                var isReturned = r.ReturnDate != null;

                <tr class="@(isOverdue ? "table-danger" : "")">
                    <td>@r.Book.Title</td>
                    <td>@r.Book.Author</td>
                    <td>@r.RentalDate.ToString("MMM d, yyyy")</td>
                    <td>@r.DueDate.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (isReturned)
                        {
                            <span class="badge bg-secondary">Returned @r.ReturnDate?.ToString("MMM d, yyyy")</span>
                        }
                        else if (isOverdue)
                        {
                            <span class="badge bg-danger">Overdue by @((int)Math.Ceiling(-daysLeft))d</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active (@((int)Math.Ceiling(daysLeft))d left)</span>
                        }
                    </td>
                    <td>
                        @if (!isReturned)
                        {
                            <form asp-action="ReturnBook" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rentalId" value="@r.Id" />
                                <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('Return this book?')">↩️ Return</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Library</a>
</div>   